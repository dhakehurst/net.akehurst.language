// KerML references (identify, scope, references) for the 'agl' KerML grammar

namespace net.akehurst.language.kerML.KerMLv1_1
    // every named element is an item of the scope of its owning element; it is found by its name and by its short name (KerML 8.2.3.5)
    // the visibility is written on the membership (the ...Member element that contains the element)
    identify net.akehurst.language.kerML.Namespaces.Namespace by namespaceDeclaration.identification.name | namespaceDeclaration.identification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Packages.Package by packageDeclaration.identification.name | packageDeclaration.identification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Packages.LibraryPackage by packageDeclaration.identification.name | packageDeclaration.identification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Types.Type by typeDeclaration.identification.name | typeDeclaration.identification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Classifiers.Classifier by classifierDeclaration.identification.name | classifierDeclaration.identification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Classes.DataType by classifierDeclaration.identification.name | classifierDeclaration.identification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Classes.Class by classifierDeclaration.identification.name | classifierDeclaration.identification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Classes.Structure by classifierDeclaration.identification.name | classifierDeclaration.identification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Classes.Association by classifierDeclaration.identification.name | classifierDeclaration.identification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Classes.AssociationStructure by classifierDeclaration.identification.name | classifierDeclaration.identification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Behaviors.Behavior by classifierDeclaration.identification.name | classifierDeclaration.identification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Behaviors.Function by classifierDeclaration.identification.name | classifierDeclaration.identification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Behaviors.Predicate by classifierDeclaration.identification.name | classifierDeclaration.identification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Interactions.Interaction by classifierDeclaration.identification.name | classifierDeclaration.identification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Metadata.Metaclass by classifierDeclaration.identification.name | classifierDeclaration.identification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Types.MultiplicityRange by identification.name | identification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Features.MultiplicitySubset by identification.name | identification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Features.Feature by featureKind.featureDeclaration.featureDeclarationKind.featureIdentification.name | featureKind.featureDeclaration.featureDeclarationKind.featureIdentification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Behaviors.Step by featureDeclaration.featureDeclarationKind.featureIdentification.name | featureDeclaration.featureDeclarationKind.featureIdentification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Behaviors.Expression by featureDeclaration.featureDeclarationKind.featureIdentification.name | featureDeclaration.featureDeclarationKind.featureIdentification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Behaviors.BooleanExpression by featureDeclaration.featureDeclarationKind.featureIdentification.name | featureDeclaration.featureDeclarationKind.featureIdentification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Behaviors.Invariant by featureDeclaration.featureDeclarationKind.featureIdentification.name | featureDeclaration.featureDeclarationKind.featureIdentification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Connectors.Connector by connectorKind.featureDeclaration.featureDeclarationKind.featureIdentification.name | connectorKind.binaryConnectorPrefix.featureDeclaration.featureDeclarationKind.featureIdentification.name | connectorKind.featureDeclaration.featureDeclarationKind.featureIdentification.shortName.name | connectorKind.binaryConnectorPrefix.featureDeclaration.featureDeclarationKind.featureIdentification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Connectors.BindingConnector by bindingConnectorDeclaration.featureDeclaration.featureDeclarationKind.featureIdentification.name | bindingConnectorDeclaration.featureDeclaration.featureDeclarationKind.featureIdentification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Connectors.Succession by successionDeclaration.featureDeclaration.featureDeclarationKind.featureIdentification.name | successionDeclaration.featureDeclaration.featureDeclarationKind.featureIdentification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Interactions.Flow by flowDeclaration.featureDeclaration.featureDeclarationKind.featureIdentification.name | flowDeclaration.featureDeclaration.featureDeclarationKind.featureIdentification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Interactions.SuccessionFlow by flowDeclaration.featureDeclaration.featureDeclarationKind.featureIdentification.name | flowDeclaration.featureDeclaration.featureDeclarationKind.featureIdentification.shortName.name visibility $container.memberPrefix.visibilityIndicator
    identify net.akehurst.language.kerML.Namespaces.AliasMember by identification.name | identification.shortName.name visibility memberPrefix.visibilityIndicator alias-for importedName.name

    // the imports of a namespace or package
    scope net.akehurst.language.kerML.Namespaces.RootNamespace {
        import forall namespaceBodyElement of-type net.akehurst.language.kerML.Namespaces.ImportOfMembership element importedName.name recursive importRecursive != $nothing visibility visibilityIndicator
        import forall namespaceBodyElement of-type net.akehurst.language.kerML.Namespaces.ImportOfNamespace members-of importedName.name recursive importRecursive != $nothing visibility visibilityIndicator
    }
    scope net.akehurst.language.kerML.Namespaces.Namespace {
        import forall namespaceBody.namespaceBodyElement of-type net.akehurst.language.kerML.Namespaces.ImportOfMembership element importedName.name recursive importRecursive != $nothing visibility visibilityIndicator
        import forall namespaceBody.namespaceBodyElement of-type net.akehurst.language.kerML.Namespaces.ImportOfNamespace members-of importedName.name recursive importRecursive != $nothing visibility visibilityIndicator
    }
    scope net.akehurst.language.kerML.Packages.Package {
        import forall packageBody.packageBodyElement of-type net.akehurst.language.kerML.Namespaces.ImportOfMembership element importedName.name recursive importRecursive != $nothing visibility visibilityIndicator
        import forall packageBody.packageBodyElement of-type net.akehurst.language.kerML.Namespaces.ImportOfNamespace members-of importedName.name recursive importRecursive != $nothing visibility visibilityIndicator
    }
    scope net.akehurst.language.kerML.Packages.LibraryPackage {
        import forall packageBody.packageBodyElement of-type net.akehurst.language.kerML.Namespaces.ImportOfMembership element importedName.name recursive importRecursive != $nothing visibility visibilityIndicator
        import forall packageBody.packageBodyElement of-type net.akehurst.language.kerML.Namespaces.ImportOfNamespace members-of importedName.name recursive importRecursive != $nothing visibility visibilityIndicator
    }
    // a classifier inherits the members of its superclassifiers (:>), a feature the members of its types (:),
    // subsetted (:>), referenced (::>), crossed (=>) and redefined (:>>) features
    scope net.akehurst.language.kerML.Classifiers.Classifier {
        inherit forall classifierDeclaration.classifierSpecialization.qualifiedName members-of name
    }
    scope net.akehurst.language.kerML.Classes.DataType {
        inherit forall classifierDeclaration.classifierSpecialization.qualifiedName members-of name
    }
    scope net.akehurst.language.kerML.Classes.Class {
        inherit forall classifierDeclaration.classifierSpecialization.qualifiedName members-of name
    }
    scope net.akehurst.language.kerML.Classes.Structure {
        inherit forall classifierDeclaration.classifierSpecialization.qualifiedName members-of name
    }
    scope net.akehurst.language.kerML.Classes.Association {
        inherit forall classifierDeclaration.classifierSpecialization.qualifiedName members-of name
    }
    scope net.akehurst.language.kerML.Classes.AssociationStructure {
        inherit forall classifierDeclaration.classifierSpecialization.qualifiedName members-of name
    }
    scope net.akehurst.language.kerML.Behaviors.Behavior {
        inherit forall classifierDeclaration.classifierSpecialization.qualifiedName members-of name
    }
    scope net.akehurst.language.kerML.Behaviors.Function {
        inherit forall classifierDeclaration.classifierSpecialization.qualifiedName members-of name
    }
    scope net.akehurst.language.kerML.Behaviors.Predicate {
        inherit forall classifierDeclaration.classifierSpecialization.qualifiedName members-of name
