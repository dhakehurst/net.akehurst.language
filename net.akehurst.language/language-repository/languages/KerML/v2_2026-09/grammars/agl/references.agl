    scope net.akehurst.language.kerML.Interactions.Interaction {
        inherit forall classifierDeclaration.classifierSpecialization.qualifiedName members-of name
    }
    scope net.akehurst.language.kerML.Metadata.Metaclass {
        inherit forall classifierDeclaration.classifierSpecialization.qualifiedName members-of name
    }
    scope net.akehurst.language.kerML.Features.Feature {
        inherit forall featureKind.featureDeclaration.featureDeclarationKind.featureIdentifiedSpecialization.featureSpecialization of-type net.akehurst.language.kerML.Features.Typings members-of typedBy.generalType.name
        inherit forall featureKind.featureDeclaration.featureDeclarationKind.featureIdentifiedSpecialization.featureSpecialization of-type net.akehurst.language.kerML.Features.Subsettings members-of subsets.generalType.name
        inherit forall featureKind.featureDeclaration.featureDeclarationKind.featureIdentifiedSpecialization.featureSpecialization of-type net.akehurst.language.kerML.Features.Redefinitions members-of redefines.generalType.name
        inherit forall featureKind.featureDeclaration.featureDeclarationKind.featureIdentifiedSpecialization.featureSpecialization of-type net.akehurst.language.kerML.Features.References members-of generalType.name
        inherit forall featureKind.featureDeclaration.featureDeclarationKind.featureIdentifiedSpecialization.featureSpecialization of-type net.akehurst.language.kerML.Features.Crosses members-of generalType.name
    }
    scope net.akehurst.language.kerML.Behaviors.Step {
        inherit forall featureDeclaration.featureDeclarationKind.featureIdentifiedSpecialization.featureSpecialization of-type net.akehurst.language.kerML.Features.Typings members-of typedBy.generalType.name
        inherit forall featureDeclaration.featureDeclarationKind.featureIdentifiedSpecialization.featureSpecialization of-type net.akehurst.language.kerML.Features.Subsettings members-of subsets.generalType.name
        inherit forall featureDeclaration.featureDeclarationKind.featureIdentifiedSpecialization.featureSpecialization of-type net.akehurst.language.kerML.Features.Redefinitions members-of redefines.generalType.name
        inherit forall featureDeclaration.featureDeclarationKind.featureIdentifiedSpecialization.featureSpecialization of-type net.akehurst.language.kerML.Features.References members-of generalType.name
        inherit forall featureDeclaration.featureDeclarationKind.featureIdentifiedSpecialization.featureSpecialization of-type net.akehurst.language.kerML.Features.Crosses members-of generalType.name
