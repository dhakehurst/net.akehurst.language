    // an import imports into the scope that it is in (of a package, or of the definition or usage in whose body it is)
    import-into-scope net.akehurst.language.sysML.Packages.ImportOfMembership element importedName.name recursive importRecursive != $nothing visibility visibilityIndicator
    import-into-scope net.akehurst.language.sysML.Packages.ImportOfNamespace members-of importedName.name recursive importRecursive != $nothing visibility visibilityIndicator

    // the elements that own other elements (namespaces)
    // a usage has the members of its types; for a conjugated port typing ('~P', typedBy.featureTyping.qualifiedName) the members of P
    // the types that a name can refer to (the targets of the references below)
    type-group Referable = net.akehurst.language.sysML.SysMLv2_1.DefinitionElement | net.akehurst.language.sysML.SysMLv2_1.UsageElement | net.akehurst.language.sysML.Actions.ActionNode | net.akehurst.language.sysML.Attributes.EnumeratedValue | net.akehurst.language.sysML.Cases.ObjectiveRequirementUsage | net.akehurst.language.sysML.Connections.DefaultInterfaceEnd | net.akehurst.language.sysML.Connections.InterfaceEnd | net.akehurst.language.sysML.Occurrences.PayloadFeatureDeclared | net.akehurst.language.sysML.Actions.PayloadParameterTriggered | net.akehurst.language.sysML.Occurrences.ConnectorEnd | net.akehurst.language.sysML.DefinitionAndUsage.VariantReference | net.akehurst.language.sysML.DefinitionAndUsage.OwnedCrossFeature | net.akehurst.language.sysML.Requirements.ActorUsage | net.akehurst.language.sysML.Requirements.StakeholderUsage | net.akehurst.language.sysML.Requirements.SubjectUsage | net.akehurst.language.sysML.States.StatePerformActionUsage | net.akehurst.language.sysML.States.StateAcceptActionUsage | net.akehurst.language.sysML.States.StateSendActionUsage | net.akehurst.language.sysML.States.StateAssignmentActionUsage | net.akehurst.language.sysML.States.TransitionPerformActionUsage | net.akehurst.language.sysML.States.TransitionAcceptActionUsage | net.akehurst.language.sysML.States.TransitionAssignmentActionUsage | net.akehurst.language.sysML.States.TransitionSendActionUsage | net.akehurst.language.sysML.States.TransitionUsage | net.akehurst.language.sysML.Packages.AliasMember | net.akehurst.language.kerML.Namespaces.Namespace | net.akehurst.language.kerML.Packages.Package | net.akehurst.language.kerML.Packages.LibraryPackage | net.akehurst.language.kerML.Types.Type | net.akehurst.language.kerML.Classifiers.Classifier | net.akehurst.language.kerML.Classes.DataType | net.akehurst.language.kerML.Classes.Class | net.akehurst.language.kerML.Classes.Structure | net.akehurst.language.kerML.Classes.Association | net.akehurst.language.kerML.Classes.AssociationStructure | net.akehurst.language.kerML.Behaviors.Behavior | net.akehurst.language.kerML.Behaviors.Function | net.akehurst.language.kerML.Behaviors.Predicate | net.akehurst.language.kerML.Interactions.Interaction | net.akehurst.language.kerML.Metadata.Metaclass | net.akehurst.language.kerML.Types.MultiplicityRange | net.akehurst.language.kerML.Features.MultiplicitySubset | net.akehurst.language.kerML.Features.Feature | net.akehurst.language.kerML.Behaviors.Step | net.akehurst.language.kerML.Behaviors.Expression | net.akehurst.language.kerML.Behaviors.BooleanExpression | net.akehurst.language.kerML.Behaviors.Invariant | net.akehurst.language.kerML.Connectors.Connector | net.akehurst.language.kerML.Connectors.BindingConnector | net.akehurst.language.kerML.Connectors.Succession | net.akehurst.language.kerML.Interactions.Flow | net.akehurst.language.kerML.Interactions.SuccessionFlow | net.akehurst.language.kerML.Namespaces.AliasMember

    scope net.akehurst.language.sysML.Packages.Package { }
    scope net.akehurst.language.sysML.Packages.LibraryPackage { }
    scope net.akehurst.language.sysML.Actions.AcceptNode {
        inherit forall acceptNodeDeclaration.actionNodeUsageDeclaration.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.Typings members-of typedBy.featureTyping.name
        inherit forall acceptNodeDeclaration.actionNodeUsageDeclaration.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.Typings members-of typedBy.featureTyping.qualifiedName.name
        inherit forall acceptNodeDeclaration.actionNodeUsageDeclaration.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.Subsettings members-of subsets.ownedSubsetting.name
        inherit forall acceptNodeDeclaration.actionNodeUsageDeclaration.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.Redefinitions members-of redefines.ownedRedefinition.name
        inherit forall acceptNodeDeclaration.actionNodeUsageDeclaration.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.References members-of ownedReferenceSubsetting.name
        inherit named Actions.acceptActions
    }
    scope net.akehurst.language.sysML.Actions.ActionDefinition {
        inherit forall definitionDeclaration.subclassificationPart.qualifiedName members-of name
        inherit named Actions.Action
    }
