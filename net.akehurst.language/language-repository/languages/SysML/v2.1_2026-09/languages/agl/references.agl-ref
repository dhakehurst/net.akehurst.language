CaseUsage -> when { occurrenceUsagePrefix.$choice is net.akehurst.language.sysML.DefinitionAndUsage.EndUsagePrefix -> false else -> occurrenceUsagePrefix.$choice.basicUsagePrefix.refPrefix.featureDirection != $nothing }  $self is net.akehurst.language.sysML.Cases.VerificationCaseUsage -> when { occurrenceUsagePrefix.$choice is net.akehurst.language.sysML.DefinitionAndUsage.EndUsagePrefix -> false else -> occurrenceUsagePrefix.$choice.basicUsagePrefix.refPrefix.featureDirection != $nothing }  $self is net.akehurst.language.sysML.Connections.ConnectionUsage -> when { occurrenceUsagePrefix.$choice is net.akehurst.language.sysML.DefinitionAndUsage.EndUsagePrefix -> false else -> occurrenceUsagePrefix.$choice.basicUsagePrefix.refPrefix.featureDirection != $nothing }  $self is net.akehurst.language.sysML.Connections.FlowUsage -> when { occurrenceUsagePrefix.$choice is net.akehurst.language.sysML.DefinitionAndUsage.EndUsagePrefix -> false else -> occurrenceUsagePrefix.$choice.basicUsagePrefix.refPrefix.featureDirection != $nothing }  $self is net.akehurst.language.sysML.Occurrences.EventOccurrenceUsage -> when { occurrenceUsagePrefix.$choice is net.akehurst.language.sysML.DefinitionAndUsage.EndUsagePrefix -> false else -> occurrenceUsagePrefix.$choice.basicUsagePrefix.refPrefix.featureDirection != $nothing }  $self is net.akehurst.language.sysML.Occurrences.ItemUsage -> when { occurrenceUsagePrefix.$choice is net.akehurst.language.sysML.DefinitionAndUsage.EndUsagePrefix -> false else -> occurrenceUsagePrefix.$choice.basicUsagePrefix.refPrefix.featureDirection != $nothing }  $self is net.akehurst.language.sysML.Occurrences.OccurrenceUsage -> when { occurrenceUsagePrefix.$choice is net.akehurst.language.sysML.DefinitionAndUsage.EndUsagePrefix -> false else -> occurrenceUsagePrefix.$choice.basicUsagePrefix.refPrefix.featureDirection != $nothing }  $self is net.akehurst.language.sysML.Occurrences.PartUsage -> when { occurrenceUsagePrefix.$choice is net.akehurst.language.sysML.DefinitionAndUsage.EndUsagePrefix -> false else -> occurrenceUsagePrefix.$choice.basicUsagePrefix.refPrefix.featureDirection != $nothing }  $self is net.akehurst.language.sysML.Ports.PortUsage -> when { occurrenceUsagePrefix.$choice is net.akehurst.language.sysML.DefinitionAndUsage.EndUsagePrefix -> false else -> occurrenceUsagePrefix.$choice.basicUsagePrefix.refPrefix.featureDirection != $nothing }  $self is net.akehurst.language.sysML.Requirements.ConcernUsage -> when { occurrenceUsagePrefix.$choice is net.akehurst.language.sysML.DefinitionAndUsage.EndUsagePrefix -> false else -> occurrenceUsagePrefix.$choice.basicUsagePrefix.refPrefix.featureDirection != $nothing }  $self is net.akehurst.language.sysML.Requirements.RequirementUsage -> when { occurrenceUsagePrefix.$choice is net.akehurst.language.sysML.DefinitionAndUsage.EndUsagePrefix -> false else -> occurrenceUsagePrefix.$choice.basicUsagePrefix.refPrefix.featureDirection != $nothing }  $self is net.akehurst.language.sysML.States.StateUsage -> when { occurrenceUsagePrefix.$choice is net.akehurst.language.sysML.DefinitionAndUsage.EndUsagePrefix -> false else -> occurrenceUsagePrefix.$choice.basicUsagePrefix.refPrefix.featureDirection != $nothing }  $self is net.akehurst.language.sysML.Calculations.CalculationUsage -> when { occurrenceUsagePrefix.$choice is net.akehurst.language.sysML.DefinitionAndUsage.EndUsagePrefix -> false else -> occurrenceUsagePrefix.$choice.basicUsagePrefix.refPrefix.featureDirection != $nothing }  $self is net.akehurst.language.sysML.Calculations.ConstraintUsage -> when { occurrenceUsagePrefix.$choice is net.akehurst.language.sysML.DefinitionAndUsage.EndUsagePrefix -> false else -> occurrenceUsagePrefix.$choice.basicUsagePrefix.refPrefix.featureDirection != $nothing }  $self is net.akehurst.language.sysML.Views.RenderingUsage -> when { occurrenceUsagePrefix.$choice is net.akehurst.language.sysML.DefinitionAndUsage.EndUsagePrefix -> false else -> occurrenceUsagePrefix.$choice.basicUsagePrefix.refPrefix.featureDirection != $nothing }  $self is net.akehurst.language.sysML.Views.ViewUsage -> when { occurrenceUsagePrefix.$choice is net.akehurst.language.sysML.DefinitionAndUsage.EndUsagePrefix -> false else -> occurrenceUsagePrefix.$choice.basicUsagePrefix.refPrefix.featureDirection != $nothing }  $self is net.akehurst.language.sysML.Views.ViewpointUsage -> when { occurrenceUsagePrefix.$choice is net.akehurst.language.sysML.DefinitionAndUsage.EndUsagePrefix -> false else -> occurrenceUsagePrefix.$choice.basicUsagePrefix.refPrefix.featureDirection != $nothing }  else -> false }
        // the referencing form (e.g. 'perform a;'): the usage has the members of the feature it references
        inherit forall eventOccurrenceKind of-type net.akehurst.language.sysML.Occurrences.EventOccurrenceReference members-of ownedReferenceSubsetting.name
        inherit forall eventOccurrenceKind.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.Typings members-of typedBy.featureTyping.name
        inherit forall eventOccurrenceKind.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.Typings members-of typedBy.featureTyping.qualifiedName.name
        inherit forall eventOccurrenceKind.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.Subsettings members-of subsets.ownedSubsetting.name
        inherit forall eventOccurrenceKind.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.Redefinitions members-of redefines.ownedRedefinition.name
        inherit forall eventOccurrenceKind.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.References members-of ownedReferenceSubsetting.name
    }
    scope net.akehurst.language.sysML.Requirements.SatisfyRequirementUsage {
        // the referencing form (e.g. 'perform a;'): the usage has the members of the feature it references
        inherit forall satisfyRequirementKind of-type net.akehurst.language.sysML.Requirements.SatisfyRequirementReference members-of ownedReferenceSubsetting.name
        inherit forall satisfyRequirementKind.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.Typings members-of typedBy.featureTyping.name
        inherit forall satisfyRequirementKind.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.Typings members-of typedBy.featureTyping.qualifiedName.name
        inherit forall satisfyRequirementKind.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.Subsettings members-of subsets.ownedSubsetting.name
        inherit forall satisfyRequirementKind.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.Redefinitions members-of redefines.ownedRedefinition.name
        inherit forall satisfyRequirementKind.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.References members-of ownedReferenceSubsetting.name
        inherit named Requirements.satisfiedRequirementChecks
    }
    scope net.akehurst.language.sysML.States.ExhibitStateUsage {
        // the referencing form (e.g. 'perform a;'): the usage has the members of the feature it references
        inherit forall exhibitStateKind of-type net.akehurst.language.sysML.States.ExhibitStateReference members-of ownedReferenceSubsetting.name
        inherit forall exhibitStateKind.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.Typings members-of typedBy.featureTyping.name
        inherit forall exhibitStateKind.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.Typings members-of typedBy.featureTyping.qualifiedName.name
        inherit forall exhibitStateKind.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.Subsettings members-of subsets.ownedSubsetting.name
        inherit forall exhibitStateKind.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.Redefinitions members-of redefines.ownedRedefinition.name
        inherit forall exhibitStateKind.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.References members-of ownedReferenceSubsetting.name
    }
    scope net.akehurst.language.sysML.Calculations.AssertConstraintUsage {
        // the referencing form (e.g. 'perform a;'): the usage has the members of the feature it references
        inherit forall assertConstraintKind of-type net.akehurst.language.sysML.Calculations.AssertConstraintReference members-of ownedReferenceSubsetting.name
        inherit forall assertConstraintKind.constraintUsageDeclaration.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.Typings members-of typedBy.featureTyping.name
        inherit forall assertConstraintKind.constraintUsageDeclaration.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.Typings members-of typedBy.featureTyping.qualifiedName.name
        inherit forall assertConstraintKind.constraintUsageDeclaration.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.Subsettings members-of subsets.ownedSubsetting.name
        inherit forall assertConstraintKind.constraintUsageDeclaration.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.Redefinitions members-of redefines.ownedRedefinition.name
        inherit forall assertConstraintKind.constraintUsageDeclaration.usageDeclaration.featureSpecializationPart.featureSpecialization of-type net.akehurst.language.sysML.DefinitionAndUsage.References members-of ownedReferenceSubsetting.name
        inherit named Constraints.assertedConstraintChecks
    }
    scope net.akehurst.language.sysML.Actions.ActionNode { }
    scope net.akehurst.language.sysML.States.StateActionUsage { }
    scope net.akehurst.language.sysML.SysMLv2_1.DefinitionElement { }
    scope net.akehurst.language.sysML.SysMLv2_1.UsageElement { }

    references {
        in net.akehurst.language.sysML.Packages.ImportOfMembership { property importedName.name.map({ n -> n.removeSurrounding('\'') }) refers-to Referable }
        in net.akehurst.language.sysML.Packages.ImportOfNamespace { property importedName.name.map({ n -> n.removeSurrounding('\'') }) refers-to Referable }
        in net.akehurst.language.sysML.Packages.AliasMember { property importedName.name.map({ n -> n.removeSurrounding('\'') }) refers-to Referable }
        in net.akehurst.language.sysML.Base.QualifiedName { property name.map({ n -> n.removeSurrounding('\'') }) refers-to Referable }
        // the redefined feature: looked up in what the owning type inherits, then outwards, never in the owning type itself (so not the redefining feature, which may have the same, effective, name)
        in net.akehurst.language.sysML.DefinitionAndUsage.Redefinitions { forall redefines.ownedRedefinition of-type net.akehurst.language.sysML.Base.QualifiedName { property name.map({ n -> n.removeSurrounding('\'') }) refers-to Referable from inherited $owner.$owner } }
        // a feature of a metadata body ('name = "x";') redefines a feature of the metadata usage's type: looked up in what the owning metadata usage (or metadata body usage) inherits, then outwards
        in net.akehurst.language.sysML.Metadata.MetadataBodyUsage { forall ownedRedefinition of-type net.akehurst.language.sysML.Base.QualifiedName { property name.map({ n -> n.removeSurrounding('\'') }) refers-to Referable from inherited $owner } }
        // a feature chain a.b.c: each later element is a member of what the previous one refers to
        in net.akehurst.language.sysML.Base.FeatureChain { forall qualifiedName { property name.map({ n -> n.removeSurrounding('\'') }) refers-to Referable from $previous.name } }
        in net.akehurst.language.sysML.Base.FeatureReference { forall qualifiedName { property name.map({ n -> n.removeSurrounding('\'') }) refers-to Referable from $previous.name } }
        // a FeatureReference is a list (of QualifiedName) property of the element that uses it, so each element that uses one has the chain rule: each later name is a member of what the previous one refers to
        in net.akehurst.language.sysML.Connections.FlowEnds { forall featureReference { property name.map({ n -> n.removeSurrounding('\'') }) refers-to Referable from $previous.name } forall featureReference2 { property name.map({ n -> n.removeSurrounding('\'') }) refers-to Referable from $previous.name } }
        in net.akehurst.language.sysML.Connections.FlowDeclarationUnnamed { forall featureReference { property name.map({ n -> n.removeSurrounding('\'') }) refers-to Referable from $previous.name } forall featureReference2 { property name.map({ n -> n.removeSurrounding('\'') }) refers-to Referable from $previous.name } }
        in net.akehurst.language.sysML.Expressions.InvocationExpression { forall featureReference { property name.map({ n -> n.removeSurrounding('\'') }) refers-to Referable from $previous.name } }
        in net.akehurst.language.sysML.Expressions.ConstructorExpression { forall featureReference { property name.map({ n -> n.removeSurrounding('\'') }) refers-to Referable from $previous.name } }
        in net.akehurst.language.sysML.Actions.GuardedSuccession { forall featureReference { property name.map({ n -> n.removeSurrounding('\'') }) refers-to Referable from $previous.name } }
        in net.akehurst.language.sysML.States.TransitionUsage { forall featureReference { property name.map({ n -> n.removeSurrounding('\'') }) refers-to Referable from $previous.name } }
        // an expression chain f.h: the first name is a member of what the base expression refers to (only a name as base)
        // the base of the chain is a cast '(e as T)' or '(as T)': the first name is looked up in T
        in net.akehurst.language.sysML.Expressions.FeatureChainExpression { forall featureReference {
            property name.map({ n -> n.removeSurrounding('\'') }) when {
                $container.nonFeatureChainPrimaryExpression.sequenceExpressionList.ownedExpression.first.classification_operator == 'as' -> refers-to Referable from $previous.name else nonFeatureChainPrimaryExpression.sequenceExpressionList.ownedExpression.qualifiedName.name
                else -> refers-to Referable from $previous.name else nonFeatureChainPrimaryExpression.qualifiedName.name
            }
        } }
        // 'assign f.h := ...': the first name of the target is a member of what the base expression refers to (only a name as base)
        in net.akehurst.language.sysML.Actions.AssignmentNodeDeclaration { forall featureReference { property name.map({ n -> n.removeSurrounding('\'') }) refers-to Referable from $previous.name else assignmentTargetParameter.nonFeatureChainPrimaryExpression.qualifiedName.name } }
    }
