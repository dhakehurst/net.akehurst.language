  data CrossSubsetting : Subsetting {
    constructor(ref val str _identity: Any)
    ref var str crossedFeature: Feature
    drv crossingFeature: Feature
  }
  data EndFeatureMembership : FeatureMembership {
    constructor(ref val str _identity: Any)
    drv ownedMemberFeature: Feature
  }
  data Feature : Type {
    constructor(ref val str _identity: Any)
    drv owningType: Type?
    cmp var str isUnique: Boolean?
    cmp var str isOrdered: Boolean?
    drv type: OrderedSet<Type>
    drv ownedRedefinition: Set<Redefinition>
    drv ownedSubsetting: Set<Subsetting>
    drv owningFeatureMembership: FeatureMembership?
    cmp var str isComposite: Boolean?
    cmp var str isEnd: Boolean?
    drv endOwningType: Type?
    drv ownedTyping: OrderedSet<FeatureTyping>
    drv featuringType: OrderedSet<Type>
    drv ownedTypeFeaturing: OrderedSet<TypeFeaturing>
    cmp var str isDerived: Boolean?
    drv chainingFeature: List<Feature>
    drv ownedFeatureInverting: Set<FeatureInverting>
    drv ownedFeatureChaining: OrderedSet<FeatureChaining>
    cmp var str isPortion: Boolean?
    cmp var str isVariable: Boolean?
    cmp var str isConstant: Boolean?
    drv ownedReferenceSubsetting: ReferenceSubsetting?
    drv featureTarget: Feature
    drv crossFeature: Feature?
    cmp var str direction: FeatureDirectionKind?
    drv ownedCrossSubsetting: CrossSubsetting?
  }
  data FeatureChaining : Relationship {
    constructor(ref val str _identity: Any)
    ref var str chainingFeature: Feature
    drv featureChained: Feature
  }
  data FeatureInverting : Relationship {
    constructor(ref val str _identity: Any)
    ref var str featureInverted: Feature
    ref var str invertingFeature: Feature
    drv owningFeature: Feature?
  }
  data FeatureTyping : Specialization {
    constructor(ref val str _identity: Any)
    ref var str typedFeature: Feature
    ref var str type: Type
    drv owningFeature: Feature?
  }
  data Redefinition : Subsetting {
    constructor(ref val str _identity: Any)
    ref var str redefiningFeature: Feature
    ref var str redefinedFeature: Feature
  }
  data ReferenceSubsetting : Subsetting {
    constructor(ref val str _identity: Any)
    ref var str referencedFeature: Feature
    drv referencingFeature: Feature
  }
  data Subsetting : Specialization {
    constructor(ref val str _identity: Any)
    ref var str subsettedFeature: Feature
    ref var str subsettingFeature: Feature
    drv owningFeature: Feature?
  }
  data TypeFeaturing : Relationship {
    constructor(ref val str _identity: Any)
    ref var str featureOfType: Feature
    ref var str featuringType: Type
    drv owningFeatureOfType: Feature?
  }
