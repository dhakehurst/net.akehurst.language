    // the elements that own other elements (namespaces)
    scope net.akehurst.language.sysML.Packages.Package {
        import forall packageBody.packageBodyElement of-type net.akehurst.language.sysML.Packages.ImportOfMembership element importedName.name recursive importRecursive != $nothing visibility visibilityIndicator
        import forall packageBody.packageBodyElement of-type net.akehurst.language.sysML.Packages.ImportOfNamespace members-of importedName.name recursive importRecursive != $nothing visibility visibilityIndicator
    }
    scope net.akehurst.language.sysML.Packages.LibraryPackage {
