// SysML references (identify, scope, references) for the 'agl' SysML grammar.
// The SysML processor is built on the KerML processor (KerML/v2_2026-09, grammar 'agl'): its types domain is the base of the SysML types
// and the KerML references are merged into these, so the KerML model libraries (.kerml) are processed by the KerML processor.
// So each 'refers-to' also lists the KerML element types.

namespace net.akehurst.language.sysML.SysMLv2_1
    // every named element is an item of the scope of its owning element
    identify net.akehurst.language.sysML.Actions.AcceptNode by acceptNodeDeclaration.actionNodeUsageDeclaration.usageDeclaration.identification.name | acceptNodeDeclaration.actionNodeUsageDeclaration.usageDeclaration.identification.shortName.name visibility $container.memberPrefix.visibilityIndicator
