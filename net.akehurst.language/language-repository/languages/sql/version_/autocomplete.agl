namespace net.akehurst.language.sql
completion SQL {
    terminatedStatement -> replace [
        CompletionItem() { label := 'Select statement' text := 'SELECT <columns> FROM <table-id>;' },
        CompletionItem() { label := 'Update statement' text := 'UPDATE <table-id> SET <column-values>;' },
        CompletionItem() { label := 'Delete statement' text := 'DELETE FROM <table-id>;' },
        CompletionItem() { label := 'Insert statement' text := 'INSERT INTO <table-id> ( <columns> ) VALUES ( <values> );' }
    ]
}
